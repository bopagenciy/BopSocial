# ============================================================================
#  Bop Social — Docker Environment Configuration Example
#
#  Copy this file to `.env.docker` before launching the stack in production:
#      cp .env.docker.example .env.docker
#
#  SECURITY NOTICE (SEC-02):
#  In production (DEBUG=False), the backend strictly rejects missing or
#  placeholder SECRET_KEY values. Generate a secure secret before running:
#      python -c "import secrets; print(secrets.token_urlsafe(50))"
# ============================================================================

# ── Security & Application Secrets ──────────────────────────────────────────
# REQUIRED in production. Must be at least 32 characters and NOT a placeholder.
SECRET_KEY=

# Set to True for local development only. Defaults to False in production.
DEBUG=False

# Hostname of the frontend application (used for CORS, CSRF, and OAuth callbacks)
FRONTEND_URL=http://localhost:3010
BACKEND_URL=http://localhost:8010

# Comma-separated list of allowed hostnames & trusted HTTPS origins
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3010
CORS_ALLOWED_ORIGINS=http://localhost:3010
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ── Port Bindings (avoid conflicts with BopHub and other ecosystem services) ─
FRONTEND_PORT=3010
BACKEND_PORT=3011

# ── Database Credentials ────────────────────────────────────────────────────
POSTGRES_DB=socialstats
POSTGRES_USER=socialstats
POSTGRES_PASSWORD=generate_a_strong_database_password_here

# ── Field-Level Encryption (AES-128 Fernet) ──────────────────────────────────
# Comma-separated list of Fernet encryption keys for token storage at rest.
# Generate a key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# ── AI Services (Configurable: ollama | anthropic) ──────────────────────────
AI_CONTENT_PROVIDER=
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
ANTHROPIC_API_KEY=

# ── Transactional Email (SMTP) ──────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Bop Social <noreply@bopsocial.com>

# ── PostgreSQL Backups ──────────────────────────────────────────────────────
BACKUP_DIR=./backups/postgres
BACKUP_RETENTION_DAYS=14

# ── Media Acceleration (Nginx X-Accel-Redirect) ──────────────────────────────
USE_X_ACCEL_REDIRECT=True
