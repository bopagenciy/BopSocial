# ============================================================================
#  Bop Social — Docker Environment Configuration Example
#
#  Copy this file to `.env.docker` before launching the stack in production:
#      cp .env.docker.example .env.docker
#
#  SECURITY NOTICE (SEC-02):
#  In production (DEBUG=False), the backend strictly rejects missing or
#  placeholder SECRET_KEY values. Generate a secure secret before running:
#      python -c "import secrets; print(secrets.token_urlsafe(50))"
# ============================================================================

# ── Security & Application Secrets ──────────────────────────────────────────
# REQUIRED in production. Must be at least 32 characters and NOT a placeholder.
SECRET_KEY=

# Set to True for local development only. Defaults to False in production.
DEBUG=False

# Hostname of the frontend application (used for CORS and OAuth callbacks)
FRONTEND_URL=http://localhost:3010

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ── Port Bindings (avoid conflicts with BopHub and other ecosystem services) ─
FRONTEND_PORT=3010
BACKEND_PORT=3011

# ── Database Credentials ────────────────────────────────────────────────────
POSTGRES_DB=socialstats
POSTGRES_USER=socialstats
POSTGRES_PASSWORD=generate_a_strong_database_password_here

# ── Field-Level Encryption (AES-128 Fernet) ──────────────────────────────────
# Comma-separated list of Fernet encryption keys for token storage at rest.
# Generate a key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# ── AI Services (Anthropic Claude) ──────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Media Acceleration (Nginx X-Accel-Redirect) ──────────────────────────────
USE_X_ACCEL_REDIRECT=True
